# =============================================================================
# paragu-ai-platform root env template.
# Copy to .env (gitignored) and fill real values.
# =============================================================================

# Base
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Build/test defaults (override per app when needed)
NEXT_TELEMETRY_DISABLED=1
TZ=UTC

# Shared integrations (optional — fill only if the app uses them)
# Supabase
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Analytics
# NEXT_PUBLIC_GA4_ID=

# Email
# EMAIL_API_KEY=
# EMAIL_LIST_ID=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
