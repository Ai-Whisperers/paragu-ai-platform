# ── SaludAbierta PY — non-standalone runtime image ──
# Build context: monorepo root (matches central.yml `docker build ... -f "$DF" .`)
# Uses the standard Next.js run model: build artifacts + prod deps + `next start`.
# Avoids the standalone output bundle which is brittle under Turbopack/webpack
# mode switches in Next 16 and produces trace-collection hangs in this codebase.
#
# Build:
#   pnpm --filter salud-abierta-py build
#   docker build -f apps/salud-abierta-py/Dockerfile.standalone \
#     -t salud-abierta-py:prod .
# Run:
#   docker service update --image salud-abierta-py:prod-<ts> salud-abierta_web

FROM node:20-alpine AS deps
WORKDIR /workspace

# Enable pnpm via corepack
RUN corepack enable && corepack prepare pnpm@9 --activate

# Copy workspace manifests
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc* tsconfig.base.json* ./
COPY packages/ packages/
COPY apps/salud-abierta-py/package.json ./apps/salud-abierta-py/

# Install prod-only deps for the app and its workspace deps
RUN pnpm install --no-frozen-lockfile --filter salud-abierta-py... --prod --ignore-scripts

# ──────────────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Generate static assets (sitemap, robots, favicon, OG image) at runtime
# These are produced by scripts/generate-assets.py + scripts/generate-sitemap.py
# during the host build step before docker build (see deploy.sh)

# Copy standalone bundle + node_modules
COPY --chown=next:node .next/standalone/apps/salud-abierta-py ./apps/salud-abierta-py
COPY --chown=next:node .next/standalone/node_modules ./node_modules

# Static chunks (JS, CSS) — CRITICAL for Next.js to load assets
COPY --chown=next:node .next/static ./apps/salud-abierta-py/.next/static

# Public + favicon + OG image
COPY --chown=next:node apps/salud-abierta-py/public ./apps/salud-abierta-py/public

# Generated assets (sitemap.xml, robots.txt, favicon.svg, images/og-default.svg)
COPY --chown=next:node apps/salud-abierta-py/scripts/generate-assets.py ./scripts/
COPY --chown=next:node apps/salud-abierta-py/scripts/generate-sitemap.py ./scripts/

# Health check + Python (for generating assets at build time)
RUN apk add --no-cache python3 py3-pip wget

# Generate assets at container start (idempotent — writes sitemap.xml, robots.txt, etc)
RUN cd /app/apps/salud-abierta-py && \
    python3 /scripts/generate-assets.py && \
    python3 /scripts/generate-sitemap.py && \
    cd /app

USER next
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api/health || exit 1

CMD ["node", "apps/salud-abierta-py/server.js"]
