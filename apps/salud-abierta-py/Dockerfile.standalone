# ── SaludAbierta PY — standalone runtime image ──
# Build context: monorepo root.
# Uses Next.js `output: 'standalone'` mode: pre-bundled server + minimal prod deps.
#
# Pre-requisites (run on host before docker build):
#   pnpm install
#   pnpm build
#   # Generate static assets in .next/standalone/apps/salud-abierta-py/public/
#   mkdir -p .next/standalone/apps/salud-abierta-py/public/images
#   cp public/favicon.svg .next/standalone/apps/salud-abierta-py/public/
#   cp public/images/og-default.svg .next/standalone/apps/salud-abierta-py/public/images/
#   python3 scripts/generate-assets.py
#   python3 scripts/generate-sitemap.py
#
# Build:
#   docker build -f apps/salud-abierta-py/Dockerfile.standalone \
#     -t salud-abierta-py:prod .
#
# Run:
#   docker service update --force --image salud-abierta-py:prod-<ts> salud-abierta_web

FROM node:20-alpine
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Install wget for HEALTHCHECK + Python for asset generation
RUN apk add --no-cache python3 wget

# Copy standalone bundle (server.js + package.json + node_modules)
COPY --chown=node:node apps/salud-abierta-py/.next/standalone/apps/salud-abierta-py ./apps/salud-abierta-py
COPY --chown=node:node apps/salud-abierta-py/.next/standalone/node_modules ./node_modules

# Copy static chunks (.next/static) — required for client-side assets
COPY --chown=node:node apps/salud-abierta-py/.next/static ./apps/salud-abierta-py/.next/static

# Copy static assets (already generated by host pre-build step)
COPY --chown=node:node apps/salud-abierta-py/.next/standalone/apps/salud-abierta-py/public ./apps/salud-abierta-py/public

USER node

EXPOSE 3000

# /api/health is the liveness probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api/health/ || exit 1

WORKDIR /app/apps/salud-abierta-py
CMD ["node", "server.js"]
