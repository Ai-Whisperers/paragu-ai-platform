# ── Nexa Paraguay — environment variables ──
# Copy this file to `.env.local` for local dev. For production, set the
# same vars in:
#   - Docker Swarm (docker stack deploy --with-registry-auth)
#   - GitHub Actions secrets (if running CI)
#   - The VPS-level `~/.hermes/nexa-health.env` (for the health-check cron)
#
# NEVER commit a file with real values to git.

# ── App ──────────────────────────────────────────────────
# Public URL. Used for canonical, OG, sitemap, robots.
# Production: https://nexaparaguay.com
NEXT_PUBLIC_APP_URL=https://nexaparaguay.com.py

# ── Supabase (auth, blog CMS, contact submissions) ──────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_PROJECT_REF=<project-ref>

# ── Analytics (Google Analytics 4) ──────────────────────
NEXT_PUBLIC_GA4_ID=G-XE49GLEP34

# ── CRM (HubSpot forms API) ─────────────────────────────
# Optional — only set if the HubSpot integration is enabled.
CRM_PORTAL_ID=
CRM_ENDPOINT=

# ── Email (Mailchimp) ────────────────────────────────────
# Optional — used by the lead-nurture sequence.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
EMAIL_FROM_ADDRESS=paraguaynexa@gmail.com
EMAIL_FROM_NAME=Nexa Paraguay

# ── Transactional email (optional) ──────────────────────
# Resend / Postmark / SendGrid — pick one.
EMAIL_TRANSACTIONAL_KEY=
EMAIL_TRANSACTIONAL_PROVIDER=resend

# ── HubSpot (used in code, see src/lib/hubspot.ts) ─────────
# HubSpot Forms API used by /api/contact for form submissions.
# HUBSPOT_PORTAL_ID and HUBSPOT_FORM_GUID are also referenced
# in code paths. The CRM_* vars above are legacy aliases.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
HUBSPOT_CONTACT_FORM=

# ── Cache revalidation (used by /api/revalidate) ───────────
# POST /api/revalidate?secret=<REVALIDATION_SECRET>&path=<path>
# Called by external webhook when content changes in the database.
REVALIDATION_SECRET=

# ── Search Console verification ────────────────────────────
# Set to the meta-tag verification code from Google Search Console.
# Leave empty to omit the meta tag.
NEXT_PUBLIC_GSC_VERIFICATION=

# ── Public site URL (alias) ────────────────────────────────
# Some code paths read NEXT_PUBLIC_SITE_URL instead of NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_SITE_URL=https://nexaparaguay.com.py
