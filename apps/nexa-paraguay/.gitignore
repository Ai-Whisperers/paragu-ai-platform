# ── Nexa Paraguay — git exclusions ──

# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
.next/
out/
dist/
*.tsbuildinfo

# Env / secrets
.env
.env.local
.env.*.local
!.env.example
!.env.example.local

# Test artifacts
coverage/
playwright-report/
test-results/
screenshots/

# OS / editor
.DS_Store
.vscode/
.idea/
.cursorindexingignore

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local tgz packages — the active ones are tracked in git for reproducible
# builds (pnpm install reads them as file: deps). The _unused/ subdirectory
# holds historical tarballs that are intentionally not tracked.
.packages/*.tgz
!.packages/ai-whisperers-*.tgz
