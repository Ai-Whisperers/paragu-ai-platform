# Ometz Dental — env vars required for production
# Copy this file to .env (or set in your CI / Vercel / Coolify panel)

# === REQUIRED for analytics ===
# Get from https://analytics.google.com → GA4 Property → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Get from https://business.facebook.com/events-manager → Pixels → Copy ID
NEXT_PUBLIC_META_PIXEL=1234567890123456

# === REQUIRED for online booking (optional) ===
# Sign up at https://calendly.com → Settings → Copy your event URL
# Example: https://calendly.com/dra-gaby/consulta-45min
NEXT_PUBLIC_CALENDLY_URL=

# === OPTIONAL — Brevo/Resend for newsletter ===
RESEND_API_KEY=
BREVO_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
