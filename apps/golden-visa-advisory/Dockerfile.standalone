FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
# Install wget for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends wget && rm -rf /var/lib/apt/lists/*
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
# Copy the app bundle
COPY --chown=nextjs:nodejs .next/standalone/apps/golden-visa-advisory ./apps/golden-visa-advisory
# Copy node_modules at root
COPY --chown=nextjs:nodejs .next/standalone/node_modules ./node_modules
# Copy static chunks (JS, CSS) — CRITICAL for Next.js to load assets
COPY --chown=nextjs:nodejs .next/static ./apps/golden-visa-advisory/.next/static
# Copy public
COPY --chown=nextjs:nodejs public ./apps/golden-visa-advisory/public
USER nextjs
EXPOSE 3000
CMD ["node", "apps/golden-visa-advisory/server.js"]
