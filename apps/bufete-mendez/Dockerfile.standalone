FROM node:20-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
# Install wget for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends wget && rm -rf /var/lib/apt/lists/*
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
# Copy the app bundle
COPY --chown=nextjs:nodejs .next/standalone/apps/bufete-mendez ./apps/bufete-mendez
# Copy node_modules at root (Next.js standalone needs them at /app/node_modules)
COPY --chown=nextjs:nodejs .next/standalone/node_modules ./node_modules
# Copy static chunks (JS, CSS) — CRITICAL for Next.js to load assets
COPY --chown=nextjs:nodejs .next/static ./apps/bufete-mendez/.next/static
# Copy public
COPY --chown=nextjs:nodejs public ./apps/bufete-mendez/public
# Copy content (for readFileSync at runtime)
COPY --chown=nextjs:nodejs ./content ./apps/bufete-mendez/content
USER nextjs
EXPOSE 3000
CMD ["node", "apps/bufete-mendez/server.js"]
