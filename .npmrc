# Ai-Whisperers monorepo npm config
# GitHub Packages registry for @ai-whisperers/* scoped packages
# Auth token must be provided via env: NODE_AUTH_TOKEN or GITHUB_TOKEN
@ai-whisperers:registry=https://npm.pkg.github.com/
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
//npm.pkg.github.com/:always-auth=true

# Shared pnpm/peer-dep settings (previously duplicated in 10+ per-app .npmrc)
auto-install-peers=true
strict-peer-dependencies=false
legacy-peer-deps=true

# Hoist shared packages to root for cross-app resolution
public-hoist-pattern[]=*
shamefully-hoist=true
