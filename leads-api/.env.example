# ============================================================
# ParaguAI Leads API — env vars
# ============================================================
# Save this file at: /root/paragu-ai-platform/leads-api/.env
# Then restart the leads-api stack:
#   docker stack deploy -c docker-compose.yml paragu-ai-leads-api
# ============================================================

# ---- Core (set these already) ----
NODE_ENV=production
PORT=3500
DATA_DIR=/var/lib/paragu-ai-leads
KIKI_WHATSAPP=+595981000000

# ---- Admin auth (CHANGE THE DEV KEY) ----
KIKI_API_KEY=CHANGE_ME_TO_RANDOM_STRING_32_CHARS

# ---- CallMeBot for WhatsApp notifications (optional) ----
# Get from: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 1. Send "I allow callmebot to send me messages" to +34 644 71 81 99 on WhatsApp
# 2. Reply with the APIKEY you get back
CALLMEBOT_APIKEY=

# ---- Stripe (subscriptions) ----
# Get from: https://dashboard.stripe.com/apikeys
# Test mode first: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe Price IDs (get from https://dashboard.stripe.com/products)
# Create 3 products: ParaguAI Lite, Pro, Empresarial
# Recurring monthly subscriptions in PYG (Paraguayan Guaraní)
# Then copy each price ID here
STRIPE_PRICE_LITE=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_EMPRESA=price_xxxxxxxxxxxxxxxxxxxxxxxx

# ---- WhatsApp Business API ----
# Get from: https://developers.facebook.com/apps → your app → WhatsApp → API Setup
# Phone Number ID: shows under "From" in the test message area
# Access Token: permanent token from System Users (NOT the temporary one)
WABA_PHONE_NUMBER_ID=
WABA_ACCESS_TOKEN=
# Webhook verify token (any string you choose, must match what you set in FB webhook config)
WABA_VERIFY_TOKEN=paragu-ai-verify-2026

# ---- Public URL ----
PUBLIC_URL=https://paragu-ai.com

# ============================================================
# NEXT_PUBLIC env vars — go into each lead site (19 sites)
# ============================================================
# Save this in each site at: apps/<slug>/.env.local
# Then rebuild + redeploy that site
# ============================================================

# Google Analytics 4 — get from https://analytics.google.com (Admin → Data Streams)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console verification token — get from
# https://search.google.com/search-console → verify → HTML tag
# It's the content="..." value
NEXT_PUBLIC_GSC_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
