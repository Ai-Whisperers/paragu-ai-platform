# ============================================================
# ParaguAI Leads API — environment variables
# ============================================================
# Copy this file to `.env` and fill in real values.

# --- Kiki's notifications ---
# WhatsApp number (E.164 format, e.g. +595981123456) that should receive lead alerts
KIKI_WHATSAPP=+595981000000

# CallMeBot API key (https://www.callmebot.com) — free WhatsApp notification API
# Steps: 1) Add bot's number +34 644 71 81 96 to WhatsApp contacts
#        2) Send "I allow callmebot to send me messages" to that contact
#        3) You'll get an API key in the response
CALLMEBOT_APIKEY=

# API key for dashboard auth (any random string)
KIKI_API_KEY=