  "faq": [
    {
      "question": "¿Qué medidas de colchones fabrican?",
      "answer": "Fabricamos todas las medidas estándar: 1 plaza (80x190), 1 plaza y media (100x190), 2 plazas (140x190), Queen (160x200), King (180x200), Super King (200x200). Medidas especiales a pedido (5-10 días hábiles)."
    },
    {
      "question": "¿Cómo elijo la firmeza correcta?",
      "answer": "Menos de 70kg: media. 70-100kg: media-firme. Más de 100kg o columna: firme. De costado: adaptable (Duo Confort)."
    },
    {
      "question": "¿Resorte o espuma?",
      "answer": "Resorte: soporte, ventilación, durabilidad. Espuma: económico o viscoelástica. Depende de preferencia y peso."
    },
    {
      "question": "¿Cuánto dura la garantía?",
      "answer": "Esencial: 2 años. Confort: 3 años. Premium (Titanium): 5 años. Ortopédico: 6 años."
    },
    {
      "question": "¿Hacen envíos a todo el país?",
      "answer": "Sí. Asunción/Metropolitana: 24-72h. Gratis desde Gs. 1.000.000. Interior: 3-7 días con costo según zona."
    },
    {
      "question": "¿Se llevan mi colchón viejo?",
      "answer": "Sí, sin costo el mismo día de entrega en compras de colchones nuevos."
    },
    {
      "question": "¿En cuántas cuotas puedo pagar?",
      "answer": "Hasta 18 cuotas sin interés. Aceptamos todas las tarjetas y transferencia bancaria."
    },
    {
      "question": "¿Cómo cuido mi colchón?",
      "answer": "Rotar cada 3 meses, usar protector impermeable, ventilar la habitación. Cambiar cada 7-10 años."
    },
    {
      "question": "¿Dónde están las tiendas?",
      "answer": "7 tiendas en Asunción y Central + 6 centros logísticos en el interior. Ver página Tiendas."
    },
    {
      "question": "¿Puedo probar el colchón en tienda?",
      "answer": "Sí, tenemos exhibición de los más vendidos. Te recomendamos acostarte 10 minutos."
    },
    {
      "question": "¿Tienen servicio técnico?",
      "answer": "Sí. Línea 0981 111 222. Evaluación y reparación dentro del período de garantía."
    }
  ],
