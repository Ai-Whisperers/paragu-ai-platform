{
  "name": "paragu-ai-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter='!packages/engine' build",
    "build:app": "pnpm --filter=\"{apps/*}\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "upgrade:deps": "pnpm update --latest",
    "rebuild:large": "for app in hidrobaby-spa portas-barber arnos-barber-shop cronos-academy estudio-medieval scott-tatuajes; do docker build -f apps/$app/Dockerfile.standalone -t ${app}:prod ./apps/$app; done"
  },
  "pnpm": {
    "overrides": {
      "next": "16.2.6",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "typescript": "5.9.3",
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1",
      "@types/node": "20.19.0"
    },
    "peerDependencyRules": {
      "allowAny": [
        "next",
        "react",
        "react-dom",
        "typescript"
      ]
    }
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "prettier": "3.4.2",
    "@types/node": "20.19.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@ai-whisperers/i18n-paraguay": "workspace:packages/i18n"
  }
}