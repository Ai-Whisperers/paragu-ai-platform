{
  "name": "paragu-ai-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter='!packages/engine' build",
    "build:app": "pnpm --filter=\"{apps/*}\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "pnpm": {
    "overrides": {
      "next": ">=16.2.0",
      "react": ">=18.3.1",
      "react-dom": ">=18.3.1",
      "typescript": ">=5.0.0",
      "@types/react": ">=18.3.0",
      "@types/node": ">=20.0.0"
    },
    "peerDependencyRules": {
      "allowAny": ["next", "react", "react-dom", "typescript"]
    }
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "prettier": "^3.0.0",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
